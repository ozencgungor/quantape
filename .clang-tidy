# clang-tidy configuration — intentionally narrow.
#
# The allowlist in repo_tools/check_tidy.sh decides which modules are checked;
# this file defines what counts as a finding. Add checks as modules are cleaned,
# not all at once (the codebase predates the config).
#
# Disabled on purpose for the current (test-driver) allowlist:
#   bugprone-exception-escape   - tests intentionally let exceptions escape
#   bugprone-random-generator-seed - fixed RNG seeds are deliberate in tests
# Revisit when library modules join the allowlist; exception-escape is valuable
# for library code.
---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-exception-escape,
  -bugprone-random-generator-seed,
  -performance-enum-size,
  -performance-unnecessary-value-param,
  -performance-avoid-endl
WarningsAsErrors: ''
HeaderFilterRegex: '^.*/include/quantape/.*$'
FormatStyle: file
UseColor: false
...
