{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debugger-first: -O0 -g3, frame pointers, asserts on, tests unoptimized; benchmarks off",
      "binaryDir": "${sourceDir}/build/debug",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "2"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QUANTAPE_BUILD_BENCHMARKS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized build (-O3 -march=native -DNDEBUG, tests at -O2); benchmarks on",
      "binaryDir": "${sourceDir}/build/release",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "2"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QUANTAPE_BUILD_BENCHMARKS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": ["build_all"],
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": ["build_all"],
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
