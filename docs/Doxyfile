# Doxyfile for Quantape — API documentation
#
# The headers are comment-dense (/** ... */ file/class/method docs), so the
# defaults plus these settings produce complete reference output. Generated
# HTML goes to docs/html (gitignored), reachable through docs/index.html;
# regenerate with
#   cmake --build build --target doc
# or directly:  doxygen docs/Doxyfile

PROJECT_NAME           = "Quantape"
PROJECT_BRIEF          = "Differentiable quant library (AD, integrators, solvers, interpolation, optimization, IFT)"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs

INPUT                  = include/quantape \
                         src \
                         README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp

# Render the repository README as the landing page
USE_MDFILE_AS_MAINPAGE = README.md

# C++20: silence unknown-command warnings from modern constructs
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = DOXYGEN_ONLY

# Extraction: rely on the existing documentation comments
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = YES

# Graphviz: class/collaboration/include/call graphs
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
MAX_DOT_GRAPH_DEPTH    = 0

# Group the top-level modules by directory
LAYOUT_FILE            =
